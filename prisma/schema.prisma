generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Utility model for database connectivity health check
model message {
  id      Int     @id @default(autoincrement())
  message String?
}

// ==========================================
// User & Authentication Models
// ==========================================

/// Core User entity representing registered platform users
model User {
  id                         String    @id @default(cuid())
  email                      String?   @unique
  name                       String?
  avatarUrl                  String?   @map("avatar_url")
  username                   String?   @unique
  passwordHash               String?   @map("password_hash")
  emailVerifiedAt            DateTime? @map("email_verified_at")
  emailVerificationTokenHash String?   @unique @map("email_verification_token_hash")
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at")
  emailVerificationSentAt    DateTime? @map("email_verification_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Account relations
  oauthAccounts      OAuthAccount[]
  userProvidePrompts UserProvidePrompt[]
  projects           Project[]

  @@map("users")
}

/// External OAuth credentials connected to user accounts (GitHub, Google)
model OAuthAccount {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  provider             String
  providerAccountId    String    @map("provider_account_id")
  accessToken          String?   @map("access_token")
  refreshToken         String?   @map("refresh_token")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")
  scope                String?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  /// Relation to owning user
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId], name: "provider_providerAccountId")
  @@index([userId])
  @@map("oauth_accounts")
}

// ==========================================
// User Input & Prompt Management
// ==========================================

/// Supported prompt input source types
enum PromptType {
  TEXT
  FILE
  URL
}

/// Raw ideas and prompts submitted by users for system generation
model UserProvidePrompt {
  id String @id @default(cuid())

  /// Owning user relation
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Input prompt metadata
  title     String?    @db.VarChar(255)
  prompt    String?    @db.Text
  inputType PromptType @default(TEXT) @map("input_type")

  /// File or URL source metadata
  originalFileName String? @map("original_file_name")
  mimeType         String? @map("mime_type")
  fileSize         Int?    @map("file_size")
  sourceUrl        String? @map("source_url")

  /// Processed and extracted text for AI analysis
  extractedText  String? @map("extracted_text") @db.Text
  normalizedText String? @map("normalized_text") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Projects generated from this prompt
  projects Project[]

  @@index([userId])
  @@map("user_provide_prompts")
}

// ==========================================
// Project & System Generation Models
// ==========================================

/// Status of the automated project generation workflow
enum ProjectStatus {
  DRAFT
  ANALYZING
  IN_PROGRESS
  COMPLETED
  FAILED
}

/// Core Project entity representing an Idea2System generated application
model Project {
  id String @id @default(cuid())

  /// Owning user relation
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Optional link to the user prompt that seeded this project
  promptId String?            @map("prompt_id")
  prompt   UserProvidePrompt? @relation(fields: [promptId], references: [id], onDelete: SetNull)

  /// Project metadata
  title       String        @default("Untitled Project") @db.VarChar(255)
  description String?       @db.Text
  status      ProjectStatus @default(DRAFT)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Generated sub-resources
  qaReports              QAReport[]
  clarificationQuestions ClarificationQuestion[]

  @@index([userId])
  @@index([promptId])
  @@map("projects")
}

/// Quality assurance audit reports for generated system artifacts
model QAReport {
  id String @id @default(cuid())

  /// Parent project relation
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Automated QA analysis results
  issues      Json?
  suggestions Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("qa_reports")
}

/// Questions generated by AI to resolve requirements ambiguities
model ClarificationQuestion {
  id String @id @default(cuid())

  /// Parent project relation
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Question content and user answer
  question String  @db.Text
  answer   String? @db.Text
  resolved Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("clarification_questions")
}
